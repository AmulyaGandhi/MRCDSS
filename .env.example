# Environment variables for MRCDSS
# Copy to .env and fill in values

# API configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Frontend configuration
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000

# Data configuration
DATA_DIR=.
DATASET1=dataset1.csv
DATASET2=dataset2.csv

# Pipeline configuration
RANDOM_STATE=42
TEST_SIZE=0.2
N_INIT=10
K_CLUSTERS=3

# Feature configuration
FEATURES=ANC_First_Trimester_Pct,TT2_Booster_Pct,Severe_Anemia_Pct,Institutional_Delivery_Pct,PNC_48h_Pct,Obstetric_Complications_Pct

# LLM provider for Disha assistant (ollama | groq | off)
MRCDSS_LLM_PROVIDER=off

# Ollama (local) configuration
MRCDSS_OLLAMA_MODEL=
MRCDSS_OLLAMA_BASE_URL=http://localhost:11434

# Groq Cloud configuration (backend only; never expose the key to the frontend)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
